<% content_for :title, "@#{@user.handle}" %>

<h1 class="font-display text-4xl">@<%= @user.handle %></h1>
<p class="mt-3 text-sm text-paper-dim">
  <%= number_to_percentage(@user.accuracy * 100, precision: 0) %> accuracy
  · conviction <%= @user.conviction.round(2) %>
  · <%= points(@user.points_balance) %> pts
</p>

<div class="mt-4 flex flex-wrap gap-2">
  <% @stats.badges.each do |badge| %>
    <span class="border border-ember px-2 py-1 text-[11px] uppercase tracking-widest text-ember"><%= badge.label %></span>
  <% end %>
</div>

<section class="mt-10 space-y-4">
  <% @predictions.each do |prediction| %>
    <article class="ticket-card p-4">
      <p class="text-[11px] uppercase tracking-widest text-ember"><%= prediction.market.artist.name %></p>
      <p class="mt-1"><%= prediction.market.question %></p>
      <p class="mt-2 text-xs text-paper-dim">
        Called <%= prediction.side.upcase %> · <%= points(prediction.points_staked) %> pts
        <% if prediction.slip %>
          · <%= link_to "slip", slip_path(prediction.slip), class: "text-ember" %>
        <% end %>
      </p>
    </article>
  <% end %>
</section>
