<% content_for :title, "Admin markets" %>
<h1 class="font-display text-3xl">Markets</h1>
<p class="mt-2"><%= link_to "New market", new_admin_market_path, class: "text-ember text-sm" %></p>

<div class="mt-6 space-y-6">
  <% @markets.each do |market| %>
    <article class="ticket-card p-4">
      <p class="text-[11px] uppercase tracking-widest text-ember"><%= market.artist.name %></p>
      <p class="mt-1"><%= market.question %></p>
      <p class="mt-2 text-xs text-paper-dim"><%= market.outcome %> · <%= market.predictions.count %> calls</p>
      <% if market.pending? %>
        <%= form_with url: resolve_admin_market_path(market), class: "mt-4 space-y-2" do %>
          <select name="outcome" class="w-full px-3 py-2">
            <option value="yes">Yes</option>
            <option value="no">No</option>
            <option value="void">Void / refund</option>
          </select>
          <input type="text" name="resolution_note" placeholder="Evidence note" class="w-full px-3 py-2 text-sm">
          <button class="w-full border border-rule py-2 text-xs uppercase tracking-widest">Resolve</button>
        <% end %>
      <% end %>
    </article>
  <% end %>
</div>
