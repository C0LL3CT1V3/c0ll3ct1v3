<% content_for :title, "New market" %>
<h1 class="font-display text-3xl">New market</h1>

<%= form_with model: [:admin, @market], class: "mt-6 space-y-4" do |f| %>
  <%= f.select :artist_id, @artists.map { |a| [a.name, a.id] }, {}, class: "w-full px-3 py-3" %>
  <%= f.text_field :question, placeholder: "Question", class: "w-full px-3 py-3" %>
  <%= f.select :kind, Market::KINDS, {}, class: "w-full px-3 py-3" %>
  <%= f.text_area :resolution_criteria, placeholder: "How an admin will decide", class: "w-full px-3 py-3" %>
  <%= f.datetime_local_field :closes_at, class: "w-full px-3 py-3" %>
  <%= f.submit "Open market", class: "w-full bg-paper py-3 font-display text-ink" %>
<% end %>
