<%= link_to market_path(market), class: "ticket-card block p-4" do %>
  <p class="text-[11px] uppercase tracking-[0.2em] text-ember"><%= market.artist.name %></p>
  <p class="mt-2 font-display text-xl leading-snug"><%= market.question %></p>
  <p class="mt-4 flex justify-between text-xs text-paper-dim">
    <span>YES <%= pool_percent(market.quote.p_yes) %></span>
    <span><%= market.believer_count %> believers</span>
    <span>closes <%= time_ago_in_words(market.closes_at) %></span>
  </p>
<% end %>
