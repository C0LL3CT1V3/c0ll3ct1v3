{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "C0ll3ct1v3VaultBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::c0ll3ct1v3-vaults"
    },
    {
      "Sid": "C0ll3ct1v3VaultObjectRW",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::c0ll3ct1v3-vaults/*"
    }
  ]
}
