REACT_APP_API_URL=http://localhost:8000

# Client bugtracker (SAM HTTP API). Leave empty to hide the Report button.
REACT_APP_BUGTRACKER_URL=

REACT_APP_AUTH0_DOMAIN=your-tenant.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id
REACT_APP_AUTH0_AUDIENCE=https://your-api-audience
REACT_APP_AUTH0_SCOPE="openid profile email"

# Step-up MFA policy identifier for popup escalation
REACT_APP_AUTH0_MFA_ACR=http://schemas.openid.net/pape/policies/2007/06/multi-factor

# Official Dropbox Chooser + Google Picker (browser sign-in — no backend OAuth)
# Dropbox: https://www.dropbox.com/developers/apps → Chooser/Saver domains must include every portal origin
# (dev: http://localhost:3030 — prod: https://c0ll3ct1v3.xyz and https://www.c0ll3ct1v3.xyz)
REACT_APP_DROPBOX_APP_KEY=

# Google Cloud Console → APIs: enable Google Picker API + Google Drive API
# Credentials → OAuth 2.0 Web client (authorized JS origin = portal URL)
# Credentials → API key (starts with AIza — NOT the GOCSPX client secret)
# Project number (numeric, from project settings — NOT the project id string like "my-app")
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_GOOGLE_API_KEY=
REACT_APP_GOOGLE_APP_ID=
