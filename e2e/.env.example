# Copy to e2e/.env (gitignored). Never commit a password.
#
# Auth0 Dashboard → User Management → Users → Create User
#   Connection: Username-Password-Authentication
#   Email: a dedicated tester, not a personal account
#   Password: store only here
#   MFA: off for this user
# Allowed callbacks must include http://localhost:3030 (and http://127.0.0.1:3030 if you use it).

E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=

# Optional: allow the same user against production (off by default).
# E2E_AUTH_ALLOW_PROD=1
